{
  "expo": {
    "name": "Football Imposter",
    "slug": "football-imposter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "footballimposter",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "comment_ios": "Native ios folder exists — run npx expo run:ios for local builds or eas build for cloud builds",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mzahariev.footballimposter",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mzahariev.footballimposter",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#06110a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06110a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74fad94b-9611-4cf9-9a94-721b8eddc1b0"
      }
    }
  }
}
